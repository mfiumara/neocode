# Workspace controlled by the coordinator and workers
NEOCODE_CWD=/path/to/project

# Local orchestration server port
NEOCODE_PORT=4318

# Completion pipeline (successful worktree workers only)
NEOCODE_MERGE_BRANCH=main
# Optional; defaults to the coordinator model
NEOCODE_JUDGE_MODEL=provider/model-id
# Optional; otherwise package.json test/check/build scripts are detected
NEOCODE_CI_COMMAND="npm test && npm run check && npm run build"
NEOCODE_CI_TIMEOUT_MS=300000
